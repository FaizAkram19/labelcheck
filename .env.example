# Copy this file to .env and fill in the key. Never commit .env.
#
# Get a key at https://aistudio.google.com/apikey
# New keys start with "AQ." - that is the current format and is correct.
GEMINI_API_KEY=paste-your-key-here

# Run `python manage.py check_key` to see which models your key can use,
# then set one here.
GEMINI_MODEL=gemini-3.8-flash

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-if-you-like
